[Unit]
Description=Sunshine for an Android virtual monitor
StartLimitIntervalSec=500
StartLimitBurst=5
BindsTo=gnome-virtual-monitor.service
After=graphical-session.target xdg-desktop-autostart.target xdg-desktop-portal.service gnome-virtual-monitor.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'attempt=0; while [ "$attempt" -lt 80 ]; do [ -e "%t/gnome-virtual-monitor.ready" ] && exit 0; attempt=$((attempt + 1)); sleep 0.25; done; exit 1'
Environment=XDG_CONFIG_HOME=%h/.config/sunshine-instances/android
Environment=SUNSHINE_MIGRATE_CONFIG=0
UMask=0077
ExecStart=/usr/bin/sunshine
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
